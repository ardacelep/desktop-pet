{
  "name": "desktop-pet",
  "version": "0.1.0",
  "description": "Şeffaf, her zaman üstte masaüstü pet uygulaması",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "tools": "python3 tools/menu.py",
    "check": "node tools/check-characters.js",
    "check:hittest": "PET_SELFTEST=1 electron .",
    "test:tools": "python3 tools/test_pixelart_extract.py && python3 tools/test_split_sheet.py && python3 tools/test_pack_sheet.py",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ardacelep.desktoppet",
    "productName": "Desktop Pet",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "characters/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": "nsis"
    }
  }
}
